# Скопируйте в .env и заполните:  cp .env.example .env
# Файл .env содержит пароли — не публикуйте его и не коммитьте в git.

# Домен сайта без https:// (для локальной проверки — localhost)
DOMAIN=alisa-smm.ru
# Полный адрес сайта: https://домен (локально — http://localhost:8080)
PUBLIC_ORIGIN=https://alisa-smm.ru

# Секретный адрес админки: сайт/<ADMIN_PATH>/ . 12–64 символа: латиница, цифры, - и _
# Сгенерировать:  openssl rand -hex 12
ADMIN_PATH=change-me-to-random-path

# Пароль базы данных. Сгенерировать:  openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_USER=portfolio
POSTGRES_DB=portfolio

# true на боевом сервере (cookie только по HTTPS). false — только для проверки на своём компьютере.
COOKIE_SECURE=true

# Необязательно: пускать в админку только с этих IP (через запятую). Пусто — с любых.
ADMIN_IP_ALLOWLIST=

# Порты на сервере
HTTP_PORT=80
HTTPS_PORT=443
